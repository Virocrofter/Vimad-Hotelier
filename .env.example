# ──────────────────────────────────────────────────────────────────────────────
# Vimad PMS — Environment Variables Template
# Copy to .env and fill in all values
# NEVER commit .env to version control
# ──────────────────────────────────────────────────────────────────────────────

# ─── Domain & TLS ───
DOMAIN=vimad.io
ACME_EMAIL=<your-acme_email>

# ─── Database ───
POSTGRES_USER=vimad
POSTGRES_PASSWORD=<your-postgres_password>
POSTGRES_DB=vimad
# Full connection URL — must match POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB above
DATABASE_URL=postgresql://vimad:WmZu6xP5y0Ywg4otxUOQuLpXx+qTydvqUKihpLQ/vUw=@postgres:5432/vimad?schema=public

# ─── Redis ───
REDIS_PASSWORD=<your-redis_password>
# Full connection URL — must match REDIS_PASSWORD above

# ─── API Secrets ───
JWT_SECRET=<your-jwt_secret>
JWT_EXPIRES_IN=15m

# ─── Email (SMTP) ───
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=<your-sendgrid_api_key>
EMAIL_FROM=<your-email_from>

# ─── Optional: Sentry ───
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ─── Optional: Stripe ───
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# ─── Optional: Twilio ───
# TWILIO_ACCOUNT_SID=ACxxx
# TWILIO_AUTH_TOKEN=xxx
# TWILIO_PHONE_NUMBER=+15551234567

# ─── Optional: AWS S3 ───
# STORAGE_PROVIDER=s3
# S3_BUCKET=vimad-storage
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=AKIAxxx
# S3_SECRET_ACCESS_KEY=xxx

# ─── CORS ───
CORS_ORIGINS=<your-cors_origins>

# ─── Ops ───
