generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenant & Identity ───

model Tenant {
  keyIssuances       KeyIssuance[]
  logbookEntries     LogbookEntry[]
  reservationRooms   ReservationRoom[]
  onboardingProgress OnboardingProgress[]
  id                 String               @id @default(cuid())
  name               String
  slug               String               @unique
  plan               String               @default("trial")
  isDemo             Boolean              @default(false)
  status             String               @default("active")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  properties                      Property[]
  users                           User[]
  guests                          Guest[]
  reservations                    Reservation[]
  roomTypes                       RoomType[]
  rooms                           Room[]
  ratePlans                       RatePlan[]
  auditLogs                       AuditLog[]
  notifications                   Notification[]
  invoices                        Invoice[]
  taxInvoices                     TaxInvoice[]
  invoiceCounters                 InvoiceCounter[]
  contracts                       Contract[]
  pushSubscriptions               PushSubscription[]
  channelConnections              ChannelConnection[]
  housekeepingTasks               HousekeepingTask[]
  nightAudits                     NightAudit[]
  nightAuditSchedules             NightAuditSchedule[]
  payments                        Payment[]
  guestPaymentMethods             GuestPaymentMethod[]
  paymentRequests                 PaymentRequest[]
  emailLogs                       EmailLog[]
  tasks                           Task[]
  taskRules                       TaskRule[]
  conciergeItems                  ConciergeItem[]
  parkingBays                     ParkingBay[]
  guestVehicles                   GuestVehicle[]
  parkingAssignments              ParkingAssignment[]
  chains                          Chain[]
  groups                          Group[]
  inventoryRestrictions           InventoryRestriction[]
  inventoryAllocations            InventoryAllocation[]
  corporateAccounts               CorporateAccount[]
  guestFollowUps                  GuestFollowUp[]
  guestSegments                   GuestSegment[]
  guestSegmentMemberships         GuestSegmentMembership[]
  restaurants                     Restaurant[]
  mealPlans                       MealPlan[]
  mealPlanAssignments             MealPlanAssignment[]
  mealPlanPostings                MealPlanPosting[]
  tickets                         Ticket[]
  arInvoices                      ArInvoice[]
  arPayments                      ArPayment[]
  arInvoiceCounters               ArInvoiceCounter[]
  reservationTraces               ReservationTrace[]
  reservationCompanions           ReservationCompanion[]
  scClients                       ScClient[]
  scEvents                        ScEvent[]
  beos                            Beo[]
  venues                          Venue[]
  menuPackages                    MenuPackage[]
  avPackages                      AvPackage[]
  setupStyles                     SetupStyle[]
  decorOptions                    DecorOption[]
  scActivities                    ScActivity[]
  cannedResponses                 CannedResponse[]
  guestIdentityGroups             GuestIdentityGroup[]
  supportCases                    SupportCase[]
  onboardingImports               OnboardingImport[]
  propertyTemplates               PropertyTemplate[]
  loyaltyConfig                   LoyaltyConfig?
  folioSplitRequests              FolioSplitRequest[]
  loyaltyRewards                  LoyaltyReward[]
  loyaltyRedemptions              LoyaltyRedemption[]
  reservationModificationRequests ReservationModificationRequest[]
  exceptions                      Exception[]

  @@map("tenants")
  lostFoundItems LostFoundItem[]
  webhookEndpoints WebhookEndpoint[]
  integrationInstallations IntegrationInstallation[]
  giftVouchers GiftVoucher[]
  paymentProofs PaymentProof[]
  securityIncidents SecurityIncident[]
}

model User {
  id             String   @id @default(cuid())
  email          String
  passwordHash   String?
  firstName      String?
  lastName       String?
  phone          String? // T5: WhatsApp/SMS task push destination (E.164)
  role           String   @default("staff")
  status         String   @default("active")
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lastPropertyId String? // C1: sticky property-switcher choice (validated in service layer)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  roleAssignments      RoleAssignment[]
  housekeepingTasks    HousekeepingTask[] @relation("AssignedTasks")
  inspectedTasks       HousekeepingTask[] @relation("InspectedTasks")
  refreshTokens        RefreshToken[]
  passwordResets       PasswordReset[]
  guestNotes           GuestNote[]
  minibarChecks        MinibarCheck[]
  assignedTasks        Task[]             @relation("TaskAssignees")
  conciergeItems       ConciergeItem[]
  scManagedClients     ScClient[]         @relation("SC_AccountManager")
  scOwnedEvents        ScEvent[]          @relation("SC_EventOwner")
  assignedTickets      Ticket[]           @relation("TicketAssignee")
  createdTickets       Ticket[]           @relation("TicketCreator")
  cannedResponses      CannedResponse[]
  supportCasesAssigned SupportCase[]      @relation("SupportCaseAssignee")
  supportCasesCreated  SupportCase[]      @relation("SupportCaseCreator")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
  agentAccountId  String?
  agentAccount    CorporateAccount? @relation(fields: [agentAccountId], references: [id], onDelete: SetNull)
  // P46 TOTP two-factor (RFC 6238)
  totpPendingSecret String?
  totpSecret        String?
  totpEnabled       Boolean @default(false)
}

// ─── C1: Chains — a tenant's properties grouped under one login ───

model Chain {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  status    String   @default("active") // active | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("chains")
}

// ─── Refresh Token (with revocation support) ───

model RefreshToken {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ─── Password Reset ───

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("password_resets")
}

// ─── Property & Inventory ───

model Property {
  autoDepositDays        Int                  @default(0) // A1-prime: auto-capture deposits N days before arrival (0 = off)
  keyIssuances           KeyIssuance[]
  logbookEntries         LogbookEntry[]
  reservationRooms       ReservationRoom[]
  onboardingProgress     OnboardingProgress[]
  id                     String               @id @default(cuid())
  tenantId               String
  tenant                 Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                   String
  code                   String
  address                String?
  city                   String?
  country                String?
  vatNumber              String?
  chainId                String?
  chain                  Chain?               @relation(fields: [chainId], references: [id], onDelete: SetNull)
  timezone               String               @default("UTC")
  currency               String               @default("ZAR")
  checkInTime            String               @default("14:00")
  checkOutTime           String               @default("10:00")
  status                 String               @default("active")
  billClosingRule        String               @default("always")
  billClosingWindowHours Int                  @default(12)
  tomsaLevyEnabled       Boolean              @default(false)
  tomsaLevyPct           Decimal              @default(1) @db.Decimal(5, 2)
  currentBusinessDate    DateTime             @default(now()) @db.Date
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  roomTypes             RoomType[]
  rooms                 Room[]
  ratePlans             RatePlan[]
  reservations          Reservation[]
  channelConnections    ChannelConnection[]
  housekeepingTasks     HousekeepingTask[]
  nightAudits           NightAudit[]
  nightAuditSchedules   NightAuditSchedule[]
  taxInvoices           TaxInvoice[]
  tasks                 Task[]
  taskRules             TaskRule[]
  conciergeItems        ConciergeItem[]
  parkingBays           ParkingBay[]
  parkingAssignments    ParkingAssignment[]
  groups                Group[]
  inventoryRestrictions InventoryRestriction[]
  inventoryAllocations  InventoryAllocation[]
  restaurants           Restaurant[]
  mealPlans             MealPlan[]
  tickets               Ticket[]
  venues                Venue[]
  scEvents              ScEvent[]
  arInvoices            ArInvoice[]
  loyaltyTransactions   LoyaltyTransaction[]
  accountingConfig      AccountingConfig?

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("properties")
  lostFoundItems LostFoundItem[]
  // SA compliance profile (TGCSA grading, liquor licence, POPIA officer)
  tgcsaGrade                 String?
  tgcsaCertificateExpiry     DateTime? @db.Date
  liquorLicenceExpiry        DateTime? @db.Date
  popiaInformationOfficerName  String?
  popiaInformationOfficerEmail String?
  tomsaAccountCode String?
}

model RoomType {
  reservationRooms ReservationRoom[]
  id               String            @id @default(cuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId       String
  property         Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name             String
  code             String
  description      String?
  baseOccupancy    Int               @default(2)
  maxOccupancy     Int               @default(4)
  status           String            @default("active")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  rooms                 Room[]
  ratePlans             RatePlan[]
  groupBlocks           GroupRoomBlock[]
  reservations          Reservation[]
  inventoryRestrictions InventoryRestriction[]
  inventoryAllocations  InventoryAllocation[]
  inventoryOverbooking  InventoryOverbooking?
  inventoryDailyCache   InventoryDailyCache[]

  @@unique([propertyId, code])
  @@index([tenantId])
  @@index([propertyId])
  @@map("room_types")
}

model Room {
  keyIssuances       KeyIssuance[]
  reservationRooms   ReservationRoom[]
  id                 String            @id @default(cuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId         String
  property           Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomTypeId         String
  roomType           RoomType          @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  number             String
  floor              String?
  status             String            @default("clean")
  housekeepingStatus String            @default("ready")
  serviceStatus      String            @default("active")
  serviceReason      String?
  parentRoomId       String?
  statusChangedAt    DateTime?
  statusChangedBy    String?
  parentRoom         Room?             @relation("RoomCascade", fields: [parentRoomId], references: [id], onDelete: SetNull)
  childRooms         Room[]            @relation("RoomCascade")
  statusEvents       RoomStatusEvent[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  reservationStays  ReservationStay[]
  housekeepingTasks HousekeepingTask[]
  tasks             Task[]
  minibarChecks     MinibarCheck[]
  conciergeItems    ConciergeItem[]

  @@unique([propertyId, number])
  @@index([tenantId])
  @@index([propertyId])
  @@index([roomTypeId])
  @@index([propertyId, serviceStatus])
  @@map("rooms")
  lostFoundItems LostFoundItem[]
}

model RoomStatusEvent {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  field      String
  from       String?
  to         String
  reason     String?
  note       String?
  actorId    String?
  createdAt  DateTime @default(now())

  @@index([tenantId, propertyId, createdAt])
  @@index([roomId, createdAt])
  @@map("room_status_events")
}

model RatePlan {
  rateFloor          Decimal?          @db.Decimal(10, 2)
  rateCeiling        Decimal?          @db.Decimal(10, 2)
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId        String
  property          Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomTypeId        String
  roomType          RoomType  @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  name              String
  code              String
  description       String?
  baseRate          Decimal   @db.Decimal(10, 2)
  currency          String    @default("ZAR")
  calculationMethod String    @default("fixed") // fixed | percent | amount
  parentRatePlanId  String?
  commissionPct     Decimal?  @db.Decimal(5, 2)
  calculationValue  Decimal?  @db.Decimal(10, 2)
  advanceDays       Int?
  startDate         DateTime?
  endDate           DateTime?
  minStay           Int?
  maxStay           Int?
  closeToArrival    Boolean   @default(false)
  closeToDeparture  Boolean   @default(false)
  status            String    @default("active")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  reservations Reservation[]

  @@unique([propertyId, code])
  @@index([tenantId])
  @@index([propertyId])
  @@index([roomTypeId])
  @@map("rate_plans")
}

// ─── Guests ───

model Guest {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName       String
  lastName        String
  email           String?
  phone           String?
  dateOfBirth     DateTime?
  nationality     String?
  address         String?
  city            String?
  country         String?
  passportNumber  String?
  loyaltyPoints   Int       @default(0)
  vipStatus       String?
  doNotDisturb    Boolean   @default(false)
  blacklisted     Boolean   @default(false)
  blacklistReason String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  reservations          Reservation[]
  preferences           GuestPreference[]
  documents             GuestDocument[]
  guestNotes            GuestNote[]
  loyaltyTransactions   LoyaltyTransaction[]
  payments              Payment[]
  paymentMethods        GuestPaymentMethod[]
  taxInvoices           TaxInvoice[]
  tasks                 Task[]
  conciergeItems        ConciergeItem[]
  vehicles              GuestVehicle[]
  tags                  String[]                 @default([])
  corporateAccountId    String?
  corporateAccount      CorporateAccount?        @relation(fields: [corporateAccountId], references: [id], onDelete: SetNull)
  crmFollowUps          GuestFollowUp[]
  segmentMemberships    GuestSegmentMembership[]
  tickets               Ticket[]
  reservationCompanions ReservationCompanion[]
  identityMemberships   GuestIdentityMember[]
  loyaltyRedemptions    LoyaltyRedemption[]
  consents              GuestConsent[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@map("guests")
  idScans           GuestIdScan[]
  lostFoundItems LostFoundItem[]
}

model GuestPreference {
  id        String   @id @default(cuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  category  String
  key       String
  value     String
  createdAt DateTime @default(now())

  @@index([guestId])
  @@map("guest_preferences")
}

model GuestDocument {
  id                 String    @id @default(cuid())
  guestId            String
  guest              Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  type               String
  number             String?
  issuedBy           String?
  issueDate          DateTime?
  expiryDate         DateTime?
  fileUrl            String?
  verificationStatus String    @default("pending") // pending | verified | rejected
  verifiedAt         DateTime?
  verifiedById       String?
  createdAt          DateTime  @default(now())

  @@index([guestId])
  @@map("guest_documents")
}

model GuestNote {
  id        String   @id @default(cuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime @default(now())
  tenantId  String
  pinned    Boolean  @default(false)

  @@index([tenantId, guestId, createdAt])
  @@index([guestId])
  @@map("guest_notes")
}

// ─── Reservations ───

model Reservation {
  keyIssuances       KeyIssuance[]
  reservationRooms   ReservationRoom[]
  id                 String            @id @default(cuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId         String
  property           Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guestId            String
  guest              Guest             @relation(fields: [guestId], references: [id], onDelete: Restrict)
  confirmationNumber String            @unique
  groupId            String?
  group              Group?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  roomTypeId         String?
  roomType           RoomType?         @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  ratePlanId         String?
  ratePlan           RatePlan?         @relation(fields: [ratePlanId], references: [id], onDelete: SetNull)
  status             String            @default("confirmed")
  source             String            @default("direct")
  arrivalDate        DateTime          @db.Date
  departureDate      DateTime          @db.Date
  nights             Int
  adults             Int               @default(1)
  children           Int               @default(0)
  notes              String?
  eta                String?
  specialRequests    String?
  marketSegment      String?
  houseUse           Boolean           @default(false)
  guaranteed         Boolean           @default(false)
  doNotMove          Boolean           @default(false)
  fixedRoom          Boolean           @default(false)
  depositDue         Decimal           @default(0) @db.Decimal(10, 2)
  depositPaid        Decimal           @default(0) @db.Decimal(10, 2)
  preArrivalSentAt   DateTime?
  confirmationSentAt DateTime?
  checkedInAt        DateTime?
  checkedOutAt       DateTime?
  checkedInBy        String?
  checkedOutBy       String?
  cancelledAt        DateTime?
  cancelledBy        String?
  cancelReason       String?
  noShowAt           DateTime?
  totalAmount        Decimal           @db.Decimal(10, 2)
  balance            Decimal           @db.Decimal(10, 2)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  stays                ReservationStay[]
  folios                Folio[]
  payments             Payment[]
  paymentRequests      PaymentRequest[]
  taxInvoices          TaxInvoice[]
  tasks                Task[]
  minibarChecks        MinibarCheck[]
  conciergeItems       ConciergeItem[]
  mealPlanAssignments  MealPlanAssignment[]
  tickets              Ticket[]
  traces               ReservationTrace[]
  companions           ReservationCompanion[]
  modificationRequests ReservationModificationRequest[]
  splitRequests        FolioSplitRequest[]
  redemptions          LoyaltyRedemption[]
  guestOrders          GuestOrder[]
  chatThreads          ChatThread[]
  reviews              Review[]

  @@index([tenantId])
  @@index([propertyId])
  @@index([guestId])
  @@index([status])
  @@index([arrivalDate, departureDate])
  @@index([tenantId, status, arrivalDate])
  @@index([tenantId, propertyId, status])
  @@index([ratePlanId])
  @@index([tenantId, arrivalDate])
  @@map("reservations")
  documents         ReservationDocument[]
  lostFoundItems LostFoundItem[]
  agentAccountId  String?
  agentAccount    CorporateAccount? @relation(fields: [agentAccountId], references: [id], onDelete: SetNull)
}

model ReservationStay {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  roomId        String
  room          Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date          DateTime    @db.Date
  rate          Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())

  @@unique([reservationId, roomId, date])
  @@index([roomId, date])
  @@index([date])
  @@index([reservationId])
  @@map("reservation_stays")
}

// ─── Multi-room bridge (addendum #3): the booking-level room list ───
// Exists from CONFIRMATION so "rooms arriving today" is countable
// pre-arrival — stays above are nightly truth and only exist post-check-in.
// Room move = mutate the row (stays keep the historical record).
model KeyIssuance {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomId        String
  room          Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guestName     String?
  issuedBy      String
  issuerName    String
  status        String       @default("active") // active | returned | lost
  issuedAt      DateTime     @default(now())
  returnedAt    DateTime?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tenantId, propertyId, status])
  @@index([roomId, status])
  @@map("key_issuances")
}

model LogbookEntry {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  authorId   String
  authorName String
  category   String   @default("general") // general | shift | maintenance | guest | incident
  message    String
  shift      String? // morning | afternoon | night
  createdAt  DateTime @default(now())

  @@index([tenantId, propertyId, createdAt])
  @@map("logbook_entries")
}

model ReservationRoom {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  roomId        String?
  room          Room?       @relation(fields: [roomId], references: [id], onDelete: SetNull)
  roomTypeId    String?
  roomType      RoomType?   @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  role          String      @default("primary") // primary | companion
  status        String      @default("upcoming") // upcoming | checked_in | checked_out | no_show | cancelled
  checkedInAt   DateTime?
  checkedOutAt  DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([reservationId, roomId])
  @@index([tenantId, propertyId, status])
  @@index([reservationId])
  @@index([roomId])
  @@map("reservation_rooms")
}

// ─── Billing ───

model Folio {
  id            String       @id @default(cuid())
  reservationId String?     
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  tenantId      String
  status        String       @default("open")
  closedAt      DateTime?
  closedBy      String?
  groupId       String?
  isMaster      Boolean      @default(false)
  totalCharges  Decimal      @default(0) @db.Decimal(10, 2)
  totalPayments Decimal      @default(0) @db.Decimal(10, 2)
  balance       Decimal      @default(0) @db.Decimal(10, 2)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  items       FolioItem[]
  payments    Payment[]
  taxInvoices TaxInvoice[]

  @@index([status])
  @@index([tenantId, status, createdAt])
  @@index([groupId])
  @@map("folios")
}

model FolioItem {
  id               String    @id @default(cuid())
  folioId          String
  folio            Folio     @relation(fields: [folioId], references: [id], onDelete: Cascade)
  type             String
  description      String
  amount           Decimal   @db.Decimal(10, 2)
  quantity         Int       @default(1)
  postedAt         DateTime  @default(now())
  consumedAt       DateTime?
  rebateOfId       String?
  createdAt        DateTime  @default(now())
  movedFromFolioId String?
  movedAt          DateTime?
  movedBy          String?

  @@index([folioId])
  @@map("folio_items")
}

model Invoice {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String?
  periodStart   DateTime  @db.Date
  periodEnd     DateTime  @db.Date
  dueDate       DateTime  @db.Date
  plan          String
  baseAmount    Decimal   @db.Decimal(10, 2)
  overageAmount Decimal   @default(0) @db.Decimal(10, 2)
  totalAmount   Decimal   @db.Decimal(10, 2)
  currency      String    @default("ZAR")
  status        String    @default("draft")
  paidAt        DateTime?
  billingPeriod String?
  items         Json?
  createdAt     DateTime  @default(now())
