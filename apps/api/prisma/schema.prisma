// ─── Phase 4: Operational exception queue (audit §6) ───
// One queue for situations needing a human. Detected idempotently
// (tenantId + dedupeKey); human decisions (resolved/dismissed) are never
// re-opened by detectors. Table created via raw SQL (see migration note).
model Exception {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId        String?
  type              String
  severity          String    @default("medium")
  title             String
  detail            String?
  recommendedAction String?
  actionUrl         String?
  reservationId     String?
  guestId           String?
  roomId            String?
  paymentId         String?
  taskId            String?
  connectionId      String?
  dedupeKey         String
  status            String    @default("open")
  ownerId           String?
  assigneeId        String?
  acknowledgedAt    DateTime?
  resolvedAt        DateTime?
  resolutionNote    String?
  dismissedAt       DateTime?
  dismissedBy       String?
  dismissReason     String?
  slaDueAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status])
  @@index([tenantId, slaDueAt])
  @@map("exceptions")
}

