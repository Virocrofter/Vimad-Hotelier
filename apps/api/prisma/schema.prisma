  @@index([tenantId, createdAt])
  @@index([status])
  @@index([relatedType, relatedId])
    openedAt      DateTime?

@@map("email_logs")
}

// [A5] SARS-compliant tax invoices & receipts
model TaxInvoice {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  propertyId     String
  property       Property     @relation(fields: [propertyId], references: [id])
  folioId        String?
  folio          Folio?       @relation(fields: [folioId], references: [id])
  reservationId  String?
  reservation    Reservation? @relation(fields: [reservationId], references: [id])
  guestId        String?
  guest          Guest?       @relation(fields: [guestId], references: [id])
  paymentId      String?      @unique
  originalId     String?
  original       TaxInvoice?  @relation("CreditNotes", fields: [originalId], references: [id])
  creditNotes    TaxInvoice[] @relation("CreditNotes")
  originalNumber String?
  reason         String?

  number   String
  type     String
  status   String @default("open")
  currency String @default("ZAR")

  subtotalExVat Decimal @db.Decimal(12, 2)
  vatRate       Decimal @default(15.00) @db.Decimal(5, 2)
  vatAmount     Decimal @db.Decimal(12, 2)
  totalInclVat  Decimal @db.Decimal(12, 2)
  amountPaid    Decimal @default(0) @db.Decimal(12, 2)

  propertyName  String
  propertyVatNo String?
  guestName     String
  guestEmail    String?

  issueDate DateTime  @default(now())
  pdfPath   String?
  sentAt    DateTime?

  items     TaxInvoiceItem[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([tenantId, number])
  @@index([folioId])
  @@index([reservationId])
  @@map("tax_invoices")
}

model TaxInvoiceItem {
  id          String     @id @default(cuid())
  invoiceId   String
  invoice     TaxInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal    @default(1) @db.Decimal(10, 2)
  unitPriceEx Decimal    @db.Decimal(12, 2)
  vatRate     Decimal    @default(15.00) @db.Decimal(5, 2)
  amountEx    Decimal    @db.Decimal(12, 2)

  @@map("tax_invoice_items")
}

// [A5] Sequential numbering
model InvoiceCounter {
  tenantId   String   @id
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("invoice_counters")
}

// ─── T1: Universal Task model + Rules engine ───

model Task {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  department    String
  title         String
  description   String?
  status        String       @default("open")
  priority      String       @default("normal")
  roomId        String?
  room          Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  guestId       String?
  guest         Guest?       @relation(fields: [guestId], references: [id], onDelete: SetNull)
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  assigneeId    String?
  assignee      User?        @relation("TaskAssignees", fields: [assigneeId], references: [id], onDelete: SetNull)

  dueAt       DateTime?
  slaMinutes  Int?
  slaBreached Boolean   @default(false)
  blocksSpaceStatus Boolean   @default(false)
  escalateAt        DateTime?
  attachments       Json?
  sourceLanguage    String?

  ruleId    String?
  rule      TaskRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  ruleKey   String?
  ruleAudit Json?

  entityType String?
  entityId   String?

  dedupeKey String?
  source    String  @default("manual")

  metadata Json?

  pushToken          String?   @unique
  pushTokenExpiresAt DateTime?
  pushChannel        String?
  pushSentAt         DateTime?
  pushAttempts       Int       @default(0)
  completedAt        DateTime?

  completedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, status])
  @@index([tenantId, department, status])
  @@index([propertyId, status, dueAt])
  @@index([assigneeId, status])
  @@index([ruleId])
  @@index([status, slaBreached])
  @@index([tenantId, ruleId, entityType, entityId])
  @@map("tasks")
}

model TaskRule {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  propertyId   String?
  property     Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  key          String
  name         String
  department   String
  description  String?
  trigger      Json      @default("{}")
  conditions   Json      @default("{}")
  action       Json      @default("{}")
  config       Json      @default("{}")
  isActive     Boolean   @default(true)
  lastRunAt    DateTime?
  lastRunCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tasks Task[]

  @@unique([tenantId, key])
  @@map("task_rules")
}

