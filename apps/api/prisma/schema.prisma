}

// ─── RBAC: Roles ───

model Role {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String   @default("custom")
  isDefault   Boolean  @default(false)
  isLocked    Boolean  @default(false)
  tenantId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  roleAssignments RoleAssignment[]

  @@index([tenantId])
  @@map("roles")
}

// ─── RBAC: Permissions (Resource + Action Matrix) ───

model Permission {
  id          String  @id @default(cuid())
  resource    String
  action      String
  description String?
  category    String  @default("general")

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

// ─── RBAC: Role-Permission Junction ───

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String
  conditions   Json?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ─── RBAC: User-Role Assignment (with property scope) ───

model RoleAssignment {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  propertyId String?
  assignedAt DateTime @default(now())
  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, propertyId])
  @@index([userId])
  @@index([roleId])
  @@map("role_assignments")
}

// ─── API Keys with Scoped Permissions ───

model ApiKey {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  keyHash      String
  keyPrefix    String
  scopes       String[]
  status       String    @default("active")
  environment  String    @default("production")
  rateLimit    String    @default("1000/min")
  expiresAt    DateTime?
  lastUsedAt   DateTime?
  usageCount   Int       @default(0)
  createdBy    String?
  revokedAt    DateTime?
  revokedBy    String?
  revokeReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId])
  @@index([keyPrefix])
  @@index([status])
  @@map("api_keys")
}

// ─── Idempotency Keys ───

model IdempotencyKey {
  id          String   @id @default(cuid())
  key         String   @unique
  scope       String
  requestPath String?
  requestBody Json?
  payload     Json?
  response    Json?
  status      String   @default("pending")
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([scope])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// ─── Reports ───

model ReportTemplate {
